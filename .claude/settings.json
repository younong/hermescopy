{
  "skillOverrides": {
    "claude-api": "off",
    "code-review": "off"
  },
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "2"
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-c",
              "import os,pathlib,shlex; env=os.environ.get('CLAUDE_ENV_FILE'); project=os.environ.get('CLAUDE_PROJECT_DIR'); env and project and pathlib.Path(env).open('a', encoding='utf-8').write('export CODEX_HOME=' + shlex.quote(str(pathlib.Path(project) / '.codex')) + '\\n')"
            ],
            "timeout": 5,
            "statusMessage": "Configuring project-local Codex"
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "-c",
              "import os,runpy; runpy.run_path(os.path.join(os.environ['CLAUDE_PROJECT_DIR'],'.claude','hooks','require-development-worktree.py'),run_name='__main__')"
            ],
            "timeout": 5,
            "statusMessage": "Restoring worktree task ownership"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-c",
              "import os,runpy; runpy.run_path(os.path.join(os.environ['CLAUDE_PROJECT_DIR'],'.claude','hooks','require-development-worktree.py'),run_name='__main__')"
            ],
            "timeout": 5,
            "statusMessage": "Restoring worktree task ownership"
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-c",
              "import os,runpy; runpy.run_path(os.path.join(os.environ['CLAUDE_PROJECT_DIR'],'.claude','hooks','require-development-worktree.py'),run_name='__main__')"
            ],
            "timeout": 5,
            "statusMessage": "Checking worktree task ownership"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-c",
              "import os,runpy; runpy.run_path(os.path.join(os.environ['CLAUDE_PROJECT_DIR'],'.claude','hooks','block-review-agents.py'),run_name='__main__')"
            ],
            "timeout": 5,
            "statusMessage": "Enforcing bounded review policy"
          }
        ]
      },
      {
        "matcher": "EnterWorktree|Write|Edit|NotebookEdit|Bash|PowerShell|Monitor|Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-c",
              "import os,runpy; runpy.run_path(os.path.join(os.environ['CLAUDE_PROJECT_DIR'],'.claude','hooks','require-development-worktree.py'),run_name='__main__')"
            ],
            "timeout": 5,
            "statusMessage": "Enforcing worktree task ownership"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-c",
              "import os,runpy; runpy.run_path(os.path.join(os.environ['CLAUDE_PROJECT_DIR'],'.claude','hooks','require-development-worktree.py'),run_name='__main__')"
            ],
            "timeout": 5,
            "statusMessage": "Registering worktree task ownership"
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-c",
              "import os,runpy; runpy.run_path(os.path.join(os.environ['CLAUDE_PROJECT_DIR'],'.claude','hooks','development-workflow.py'),run_name='__main__')"
            ],
            "timeout": 5,
            "statusMessage": "Continuing approved development plan"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-c",
              "import os,runpy; runpy.run_path(os.path.join(os.environ['CLAUDE_PROJECT_DIR'],'.claude','hooks','development-workflow.py'),run_name='__main__')"
            ],
            "timeout": 5,
            "statusMessage": "Approving development plan"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-c",
              "import os,runpy; runpy.run_path(os.path.join(os.environ['CLAUDE_PROJECT_DIR'],'.claude','hooks','auto-submit-pr.py'),run_name='__main__')"
            ],
            "timeout": 120,
            "statusMessage": "Submitting verified work as a GitHub PR"
          }
        ]
      }
    ]
  }
}
