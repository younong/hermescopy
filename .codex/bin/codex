#!/bin/sh
set -eu

PROJECT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)

find_codex() (
  IFS=:
  for directory in $PATH; do
    [ -n "$directory" ] || directory=.
    candidate=$directory/codex
    if [ -x "$candidate" ] && [ "$candidate" != "$0" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
)

CODEX_BIN=$(find_codex || true)
if [ -z "$CODEX_BIN" ]; then
  printf '%s\n' 'error: codex is not installed or not available on PATH.' >&2
  exit 127
fi

export CODEX_HOME="$PROJECT_ROOT/.codex"

if [ -z "${AIXSEEK_API_KEY:-}" ]; then
  SETTINGS_FILE=$PROJECT_ROOT/.claude/settings.local.json
  if [ -f "$SETTINGS_FILE" ]; then
    PYTHON_BIN=$(command -v python || command -v python3 || true)
    if [ -z "$PYTHON_BIN" ]; then
      printf '%s\n' 'error: Python is required to read .claude/settings.local.json.' >&2
      exit 127
    fi
    AIXSEEK_API_KEY=$(
      "$PYTHON_BIN" - "$SETTINGS_FILE" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8-sig") as settings_file:
    environment = json.load(settings_file).get("env", {})

value = environment.get("AIXSEEK_API_KEY", "")
if isinstance(value, str):
    print(value, end="")
PY
    )
    export AIXSEEK_API_KEY
  fi
fi

if [ -z "${AIXSEEK_API_KEY:-}" ]; then
  printf '%s\n' 'error: AIXSEEK_API_KEY is not configured for this project.' >&2
  printf '%s\n' 'Set AIXSEEK_API_KEY or configure env.AIXSEEK_API_KEY in .claude/settings.local.json.' >&2
  exit 2
fi

exec "$CODEX_BIN" "$@"
